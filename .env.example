# Copy to .env (git-ignored). Only Tools/app_release.py and Tools/dictionary_release.py read these keys; see docs/release.md.
# Release-note drafts via an already installed and logged-in CLI:
# codex / claude / none (none writes the template without calling AI).
RELEASE_AI_PROVIDER=claude
# Empty uses the CLI's configured model; no API key is needed here.
RELEASE_AI_MODEL=
RELEASE_AI_TIMEOUT_SECONDS=600
